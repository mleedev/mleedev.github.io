{
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.5",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.4"
  },
  "scripts": {
    "build": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "watch": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "prepare-deploy": "cp ./src/script.js ./dist/",
    "deploy": "npm run build && npm run prepare-deploy && gh-pages -d ."
  }
}
